PORT=5001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=batloung_fruits
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173

# --- Social sign-in (all optional: a provider's button only works once its keys are set) ---
# Public address of THIS API. It is used to build the OAuth redirect (callback) URLs.
API_PUBLIC_URL=http://localhost:5001

# Callback URL to register with each provider: {API_PUBLIC_URL}/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple needs a Services ID, team id, key id and the .p8 private key (use \n for line breaks). Apple requires https.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Creating accounts ---
# true (default): anyone can create a Sales account (email form or first social sign-in).
# false: only an administrator can add people.
ALLOW_SIGNUP=true
# Needed to create an ADMINISTRATOR account from the sign-up page. Leave empty to switch administrator sign-up off.
# CHANGE THIS before sharing the app. With NODE_ENV=production this example value is refused.
ADMIN_SIGNUP_CODE=batloung-admin-2026
